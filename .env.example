# Upstream Anthropic endpoint
TOKENCLAW_ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Local server
TOKENCLAW_HOST=127.0.0.1
TOKENCLAW_PORT=4000

# Local SQLite DB
TOKENCLAW_DB=~/.tokenclaw/tokenclaw.sqlite3
# Optional Postgres storage. Leave unset to keep the offline SQLite default.
# TOKENCLAW_DATABASE_URL=postgresql://tokenclaw:tokenclaw@127.0.0.1:5432/tokenclaw
# TOKENCLAW_POSTGRES_POOL_MIN=1
# TOKENCLAW_POSTGRES_POOL_MAX=10

# Features
TOKENCLAW_CACHE=1
TOKENCLAW_CACHE_TOOL_CALLS=0
TOKENCLAW_CRUNCH=1
TOKENCLAW_ROUTING=1
TOKENCLAW_LOG_BODIES=0

# Optional managed optimizer recommendation bridge
# When enabled, successful recommendations with optimization_unit_id also get metadata-only outcome feedback.
# Pre-call feature units use tokenclaw.optimization_unit_features.v1 and include only derived metadata
# plus hashed grouping identifiers; prompts, params, provider bodies, responses, and raw session IDs stay local.
# Disabled is local-only mode: no managed network call is attempted and local routing/crunch/cache policy remains authoritative.
# Plural names are preferred; singular names are still accepted for existing installs.
TOKENCLAW_RECOMMENDATIONS_ENABLED=0
# TOKENCLAW_RECOMMENDATION_ENABLED=0
TOKENCLAW_RECOMMENDATION_SERVER_URL=
TOKENCLAW_RECOMMENDATION_TIMEOUT_SECONDS=1.5
# Use the feature-only /v1/policy-decision endpoint for local routing/crunch/cache actions.
# When TOKENCLAW_RECOMMENDATION_SERVER_URL is HTTP loopback (127.0.0.1, localhost, or ::1),
# the local proxy treats auth as configured for dev and sends no bearer token.
TOKENCLAW_POLICY_DECISIONS_ENABLED=0
# TOKENCLAW_POLICY_DECISION_ENABLED=0
TOKENCLAW_POLICY_DECISION_MIN_CONFIDENCE=0.75
TOKENCLAW_POLICY_DECISION_CANARY_FRACTION=0.0
# Product-level managed optimizer gates. TOKENCLAW_LOCAL_RULES_ONLY is the
# strongest opt-out and prevents managed server calls even if legacy
# recommendation flags are enabled.
# TOKENCLAW_MANAGED=0
# TOKENCLAW_MANAGED_MODE=observe_only  # observe_only | dry_run | canary | live
# TOKENCLAW_LOCAL_RULES_ONLY=1
# TOKENCLAW_MANAGED_ROUTING=1
# TOKENCLAW_MANAGED_CRUNCH=1
# TOKENCLAW_MANAGED_CACHE=1
# The only supported failure mode today is fallback-local: timeout, unreachable, non-2xx,
# invalid schema, unsupported target models, and replacement prompts keep local policy.
TOKENCLAW_RECOMMENDATION_FAILURE_MODE=fallback-local
# Required for non-loopback managed servers and any managed server that enforces auth.
# The value is sent as a bearer token and is never included in dashboard, CLI,
# recommendation, or feedback metadata.
# TOKENCLAW_MANAGED_API_KEY=
# Optional HMAC verification for managed policy bundle provenance before local apply.
# TOKENCLAW_MANAGED_POLICY_VERIFICATION_SECRET=
# Optional key-id-to-secret JSON map for rotation:
# TOKENCLAW_MANAGED_POLICY_VERIFICATION_SECRETS={"managed-key-1":"secret"}
# Persist sanitized review-only managed activation preview outcomes into the local DB.
# This is still local-only evidence; it never writes policy files or activates managed policy.
TOKENCLAW_MANAGED_ACTIVATION_PREVIEW_PERSIST_OUTCOMES=0

# Unattended worker
TOKENCLAW_WORKER=codex
TOKENCLAW_CODEX_TRANSPORT=exec
# Optional JSON price overrides for future OpenAI models, per 1M tokens:
# {"future-codex":{"input":2.0,"cached_input":0.2,"output":16.0}}
# TOKENCLAW_OPENAI_MODEL_PRICES_JSON=

# Routing target aliases
TOKENCLAW_HAIKU_MODEL=claude-haiku-4.5
TOKENCLAW_SONNET_MODEL=claude-sonnet-4.5
TOKENCLAW_OPUS_MODEL=claude-opus-4.5
