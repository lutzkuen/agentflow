# Upstream Anthropic endpoint
AGENTFLOW_ANTHROPIC_UPSTREAM=https://api.anthropic.com

# Local server
AGENTFLOW_HOST=127.0.0.1
AGENTFLOW_PORT=4000

# Local SQLite DB
AGENTFLOW_DB=~/.agentflow/agentflow.sqlite3
# Optional Postgres storage. Leave unset to keep the offline SQLite default.
# AGENTFLOW_DATABASE_URL=postgresql://agentflow:agentflow@127.0.0.1:5432/agentflow
# AGENTFLOW_POSTGRES_POOL_MIN=1
# AGENTFLOW_POSTGRES_POOL_MAX=10

# Features
AGENTFLOW_CACHE=1
AGENTFLOW_CACHE_TOOL_CALLS=0
AGENTFLOW_CRUNCH=1
AGENTFLOW_ROUTING=1
AGENTFLOW_LOG_BODIES=0

# Optional managed optimizer recommendation bridge
# When enabled, successful recommendations with optimization_unit_id also get metadata-only outcome feedback.
# Pre-call feature units use agentflow.optimization_unit_features.v1 and include only derived metadata
# plus hashed grouping identifiers; prompts, params, provider bodies, responses, and raw session IDs stay local.
# Disabled is local-only mode: no managed network call is attempted and local routing/crunch/cache policy remains authoritative.
AGENTFLOW_RECOMMENDATION_ENABLED=0
AGENTFLOW_RECOMMENDATION_SERVER_URL=http://127.0.0.1:4100
AGENTFLOW_RECOMMENDATION_TIMEOUT_SECONDS=1.5
# Use the feature-only /v1/policy-decision endpoint for local routing/crunch/cache actions.
# When AGENTFLOW_RECOMMENDATION_SERVER_URL is HTTP loopback (127.0.0.1, localhost, or ::1),
# the local proxy treats auth as configured for dev and sends no bearer token.
AGENTFLOW_POLICY_DECISION_ENABLED=1
# The only supported failure mode today is fallback-local: timeout, unreachable, non-2xx,
# invalid schema, unsupported target models, and replacement prompts keep local policy.
AGENTFLOW_RECOMMENDATION_FAILURE_MODE=fallback-local
# Required for non-loopback managed servers and any managed server that enforces auth.
# The value is sent as a bearer token and is never included in dashboard, CLI,
# recommendation, or feedback metadata.
# AGENTFLOW_MANAGED_API_KEY=
# Optional HMAC verification for managed policy bundle provenance before local apply.
# AGENTFLOW_MANAGED_POLICY_VERIFICATION_SECRET=
# Optional key-id-to-secret JSON map for rotation:
# AGENTFLOW_MANAGED_POLICY_VERIFICATION_SECRETS={"managed-key-1":"secret"}

# Unattended worker
AGENTFLOW_WORKER=codex
AGENTFLOW_CODEX_TRANSPORT=app-server
AGENTFLOW_CODEX_APP_URL=ws://127.0.0.1:4013
AGENTFLOW_CODEX_APP_AUTO_APPROVE=1
# Dashboard cost basis for Codex app-server telemetry.
# Defaults to the current API Codex model if unset.
AGENTFLOW_CODEX_APP_MODEL=gpt-5.3-codex
AGENTFLOW_CODEX_APP_PROCESSING_MODE=standard
# Optional local canary: hint safe summary-only Codex app turns to a cheaper model.
AGENTFLOW_CODEX_APP_SUMMARY_MODEL_HINT=0
AGENTFLOW_CODEX_APP_SUMMARY_MODEL_HINT_TARGET=gpt-5-codex
# Optional JSON price overrides for future OpenAI models, per 1M tokens:
# {"future-codex":{"input":2.0,"cached_input":0.2,"output":16.0}}
# AGENTFLOW_OPENAI_MODEL_PRICES_JSON=
AGENTFLOW_CODEX_APP_EFFORT=high

# Routing target aliases
AGENTFLOW_HAIKU_MODEL=claude-haiku-4.5
AGENTFLOW_SONNET_MODEL=claude-sonnet-4.5
AGENTFLOW_OPUS_MODEL=claude-opus-4.5
